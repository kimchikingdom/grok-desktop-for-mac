{
  "name": "grok-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local agent desktop app that drives the official Grok Build CLI over ACP",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @grok-desktop/desktop dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --project unit",
    "test:security": "vitest run --project security",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "build": "pnpm --filter @grok-desktop/desktop build",
    "package:mac": "pnpm --filter @grok-desktop/desktop package:mac",
    "package:win": "pnpm --filter @grok-desktop/desktop package:win",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:security"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
